# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/citizen_services_dev

# -- Embeddings ---------------------------------------------------------------
# 384  -> all-MiniLM-L6-v2 (default, fast)
# 1024 -> intfloat/multilingual-e5-large-instruct (set this + re-run init_db.py)
EMBEDDING_DIM=384

# -- Sarvam AI (Indian multilingual LLM, TTS, STT) ----------------------------
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

# -- Clerk Auth ---------------------------------------------------------------
# Primary keys (preferred)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Compatibility aliases accepted by backend config
CLERK_PUBLIC_KEY=
CLERK_PUBLIC_KE=

# Clerk API endpoints
CLERK_FRONTEND_API_URL=
CLERK_Frontend_API_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_Backend_API_URL=https://api.clerk.com

# JWKS endpoint (preferred + alias)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
JWKS_URL=
JWKS_PUBLIC_KEY=
JWKS_Public_Key=

# -- App Auth -----------------------------------------------------------------
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=RS256

# -- CORS ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -- Optional -----------------------------------------------------------------
API_KEY=optional-admin-api-key
