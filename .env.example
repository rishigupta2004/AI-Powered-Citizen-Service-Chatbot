# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/citizen_services_dev

# -- Embeddings ---------------------------------------------------------------
# 384  -> all-MiniLM-L6-v2 (default, fast)
# 1024 -> intfloat/multilingual-e5-large-instruct (set this + re-run init_db.py)
EMBEDDING_DIM=384
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ENABLED=true

# -- Sarvam AI (Indian multilingual LLM, TTS, STT) ----------------------------
# https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_replace_me
# sarvam-m is DEPRECATED — use sarvam-30b or sarvam-105b
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_CHAT_HTTP_TIMEOUT_SEC=35
SARVAM_CHAT_TIMEOUT_SEC=8
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_FALLBACK_MODEL=
SARVAM_STT_HTTP_TIMEOUT_SEC=45
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_TTS_HTTP_TIMEOUT_SEC=45
# mayura:v1 is DEPRECATED — use sarvam-translate:v1
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TRANSLATE_TIMEOUT_SEC=20

# -- Clerk Auth (canonical keys) ----------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLIC_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# -- Clerk Auth (legacy aliases for backward compatibility) -------------------
CLERK_PUBLIC_KE=pk_test_replace_me
CLERK_Frontend_API_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_Backend_API_URL=https://api.clerk.com
JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
JWKS_PUBLIC_KEY=
JWKS_Public_Key=

# -- App Auth -----------------------------------------------------------------
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=RS256

# -- CORS / Frontend ----------------------------------------------------------
FRONTEND_URL=https://seva-sindu-portal.vercel.app
VITE_API_URL=https://gov-chatbot.fly.dev
